# Security
SECRET_KEY=your_app_secret_key
DEBUG=true
ALLOWED_HOSTS=127.0.0.1,localhost

# International
LANGUAGE_CODE=en
TIME_ZONE=UTC
USE_I18N=true
USE_TZ=true

# Static / Media
STATIC_URL=static/
MEDIA_ROOT=media
MEDIA_URL=media/

# Database: sqlite (default) or mysql and postgresql
DB_ENGINE=postgresql
DATABASE_URL=psql://username:password@localhost:5432/db_name

# Development
DEVELOPMENT_MODE=false

# # Django Settings
# DJANGO_SETTINGS_MODULE=config.envs.development