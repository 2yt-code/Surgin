# Security
SECRET_KEY=your_app_secret_key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# International
LANGUAGE_CODE=en
TIME_ZONE=UTC
USE_I18N=True
USE_TZ=True

# Static / Media
STATIC_URL=static/
MEDIA_ROOT=media
MEDIA_URL=media/

# Database: sqlite (default) or mysql and postgresql
DB_ENGINE=None
DATABASE_URL=psql://username:password@localhost:5432/db_name

# Development
DEVELOPMENT_MODE=false